###
# @name Alle SWL
# curl "https://api-db.sota.org.uk/admin/swl_roll?associationID=-1" -H "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:103.0) Gecko/20100101 Firefox/103.0" -H "Accept: application/json, text/plain, */*" -H "Accept-Language: de,en-US;q=0.7,en;q=0.3" -H "Accept-Encoding: gzip, deflate, br" -H "Origin: https://www.sotadata.org.uk" -H "Connection: keep-alive" -H "Referer: https://www.sotadata.org.uk/" -H "Sec-Fetch-Dest: empty" -H "Sec-Fetch-Mode: cors" -H "Sec-Fetch-Site: cross-site"
GET https://api-db.sota.org.uk/admin/swl_roll?associationID=-1
User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:103.0) Gecko/20100101 Firefox/103.0
Accept: application/json, text/plain, */*
Accept-Language: de,en-US;q=0.7,en;q=0.3
Accept-Encoding: gzip, deflate, br
Origin: https://www.sotadata.org.uk
Connection: keep-alive
Referer: https://www.sotadata.org.uk/
