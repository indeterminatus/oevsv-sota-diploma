###
# @name JSON aller Aktivierer
GET https://api-db2.sota.org.uk/rolls/activator/-1/2026/all/all
Accept: application/json
Accept-Encoding: gzip

###
# @name JSON aller Chaser
GET https://api-db2.sota.org.uk/rolls/chaser/-1/2026/all/all
Accept: application/json

###
# @name JSON aller SWL
GET https://api-db2.sota.org.uk/rolls/swl/-1/2026/all/all
Accept: application/json

###
# @name Alle Aktivierungen pro UserID (am Beispiel OE5JFE):
# UserID for OE5JFE: 11330
# Next argument is date-range: 0 = previous 6 months, 2026 = specific year, 9999 = all entries
# Last argument is order: 0 or 1 (descending or ascending, does not really matter for us)
GET https://api-db2.sota.org.uk/logs/activator/11330/9999/1
Accept: application/json

###
# @name Alle Chases pro UserID (am Beispiel OE5JFE):
GET https://api-db2.sota.org.uk/logs/chaser/11330/9999/1
Accept: application/json

###
# @name Alle Chases pro UserID (am Beispiel OE5HKT):
GET https://api-db2.sota.org.uk/logs/chaser/79437/9999/1
Accept: application/json

###
# @name Alle Chases pro UserID (am Beispiel OE5JFE) für 2023:
GET https://api-db2.sota.org.uk/logs/chaser/11330/2023/1
Accept: application/json
Accept-Encoding: gzip, deflate, br

